# --- Base ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="LomExpress"

# --- WhatsApp Business ---
# Format international sans + ni espaces. Exemple Togo: 22890000000
NEXT_PUBLIC_WHATSAPP_NUMBER="22890000000"

# --- Database ---
# Local : SQLite (schema.prisma provider = "sqlite")
# DATABASE_URL="file:./prisma/dev.db"
# Production (Neon / Supabase / Railway) : PostgreSQL
# 1. Changer provider = "postgresql" dans prisma/schema.prisma
# 2. Coller l'URL ci-dessous
DATABASE_URL="postgresql://user:password@localhost:5432/lomexpress?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generer: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"

# Identifiants admin crees au seed
ADMIN_EMAIL="admin@lomexpress.tg"
ADMIN_PASSWORD="ChangeMe123!"

# --- Images (Cloudinary) — obligatoire en production (Vercel n'a pas de disque persistant) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="lomexpress"

# --- Email (optionnel) ---
RESEND_API_KEY=""
RESEND_FROM="LomExpress <noreply@lomexpress.tg>"
