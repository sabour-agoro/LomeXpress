# --- WhatsApp Business ---
# Format international sans + ni espaces. Exemple Togo: 22890000000
NEXT_PUBLIC_WHATSAPP_NUMBER="22890000000"

# --- Database (PostgreSQL: Neon, Supabase, Railway, local) ---
