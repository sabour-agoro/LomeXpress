# --- Base ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="LomExpress"

# --- WhatsApp Business ---
# Format international sans + ni espaces. Exemple Togo: 22890000000
NEXT_PUBLIC_WHATSAPP_NUMBER="22890000000"

# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# Generer: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"

# Identifiants admin crees au seed
ADMIN_EMAIL="admin@lomexpress.tg"
ADMIN_PASSWORD="ChangeMe123!"

# --- Images Cloudflare R2 (prioritaire en production) ---
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET="lomexpress"
CLOUDFLARE_R2_PUBLIC_BASE_URL="https://pub-xxxx.r2.dev"

# --- Images Cloudinary (alternative si R2 n'est pas configure) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="lomexpress"

# --- Email (optionnel) ---
RESEND_API_KEY=""
RESEND_FROM="LomExpress <noreply@lomexpress.tg>"
